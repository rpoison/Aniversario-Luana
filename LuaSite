<!DOCTYPE html>
<html lang="pt-PT">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Parabéns, Luana</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Parisienne&family=Playfair+Display:ital,wght@0,400;0,600;1,500&family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet">
<style>
  :root{
    --cream:#FBF3EC;
    --blush:#F3D9DE;
    --rose:#C97B8C;
    --wine:#6B2737;
    --gold:#B08D57;
    --ink:#3A2129;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html{scroll-behavior:smooth;}
  body{
    background:var(--cream);
    color:var(--ink);
    font-family:'Cormorant Garamond', serif;
    overflow-x:hidden;
  }
  @media (prefers-reduced-motion: reduce){
    *{animation-duration:0.01ms !important; animation-iteration-count:1 !important; transition-duration:0.01ms !important;}
  }

  .petal-field{position:fixed; inset:0; pointer-events:none; z-index:5; overflow:hidden;}
  .petal{
    position:absolute; top:-5%;
    width:14px; height:14px;
    background:var(--rose);
    opacity:0.55;
    border-radius:100% 0 100% 0;
    animation:fall linear infinite, sway ease-in-out infinite;
  }
  @keyframes fall{ to{ transform:translateY(110vh); } }
  @keyframes sway{ 0%,100%{ margin-left:0; } 50%{ margin-left:40px; } }

  .hero{
    min-height:100svh;
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    text-align:center;
    position:relative;
    padding:2rem 1.5rem;
    background:
      radial-gradient(circle at 50% 15%, var(--blush) 0%, transparent 55%),
      linear-gradient(180deg, var(--cream) 0%, #F6E5E1 100%);
  }
  .eyebrow{
    font-family:'Playfair Display', serif;
    font-style:italic;
    letter-spacing:0.35em;
    text-transform:uppercase;
    font-size:0.72rem;
    color:var(--rose);
    margin-bottom:1.4rem;
  }
  .hero h1{
    font-family:'Parisienne', cursive;
    font-size:clamp(4.5rem, 16vw, 9rem);
    color:var(--wine);
    line-height:0.9;
    text-shadow:0 2px 24px rgba(107,39,55,0.15);
  }
  .hero p.tagline{
    margin-top:1.6rem;
    font-size:clamp(1.05rem, 2.4vw, 1.35rem);
    font-style:italic;
    max-width:36ch;
    color:#5A3540;
  }
  .divider{
    width:64px; height:1px; background:var(--gold);
    margin:2.2rem auto; position:relative;
  }
  .divider::before{
    content:'♥';
    position:absolute; left:50%; top:50%;
    transform:translate(-50%,-55%);
    background:var(--cream);
    color:var(--gold);
    padding:0 10px;
    font-size:0.85rem;
  }
  .scroll-cue{
    position:absolute; bottom:2.4rem; left:50%; transform:translateX(-50%);
    font-size:0.68rem; letter-spacing:0.3em; text-transform:uppercase;
    color:var(--rose); opacity:0.8;
    animation:bob 2.4s ease-in-out infinite;
  }
  @keyframes bob{ 0%,100%{transform:translate(-50%,0);} 50%{transform:translate(-50%,8px);} }

  section{ position:relative; z-index:2; padding:6rem 1.5rem; }
  .section-title{
    font-family:'Playfair Display', serif;
    font-style:italic;
    font-weight:500;
    text-align:center;
    font-size:clamp(1.8rem, 4vw, 2.6rem);
    color:var(--wine);
    max-width:26ch;
    margin:0 auto 3.5rem;
  }

  .gallery{
    max-width:1080px; margin:0 auto;
    display:grid;
    grid-template-columns:repeat(auto-fit, minmax(210px, 1fr));
    gap:2.4rem 2rem;
    padding-top:1rem;
  }
  .polaroid{
    background:#fff;
    padding:14px 14px 46px;
    box-shadow:0 14px 30px -12px rgba(58,33,41,0.35);
    transition:transform .35s ease, box-shadow .35s ease;
    cursor:default;
  }
  .polaroid:nth-child(odd){ transform:rotate(-3.5deg); }
  .polaroid:nth-child(even){ transform:rotate(2.8deg); }
  .polaroid:nth-child(3n){ transform:rotate(-1.5deg); }
  .polaroid:hover{ transform:rotate(0deg) scale(1.045) translateY(-6px); box-shadow:0 22px 40px -14px rgba(58,33,41,0.45); z-index:3; }
  .polaroid .frame{
    display:block;
    width:100%;
    aspect-ratio:1/1;
    object-fit:cover;
    background:linear-gradient(135deg, var(--blush), #EFC9D1 60%, var(--rose));
  }
  .polaroid figcaption{
    text-align:center; margin-top:0.7rem; color:var(--gold); font-size:1.3rem;
    line-height:1;
  }

  .letter-wrap{
    max-width:640px; margin:0 auto;
    background:#fffdfb;
    border:1px solid #EBD8CE;
    box-shadow:0 20px 50px -20px rgba(58,33,41,0.25);
    padding:3.4rem 2.6rem;
    position:relative;
  }
  .letter-wrap::before{
    content:'❝';
    position:absolute; top:-1.6rem; left:50%; transform:translateX(-50%);
    font-family:'Playfair Display', serif;
    font-size:3rem; color:var(--gold); background:var(--cream); padding:0 0.6rem;
  }
  .letter-wrap p{
    font-size:1.18rem; line-height:1.85; margin-bottom:1.2rem; color:#4A2A34;
  }
  .letter-wrap .assinatura{
    font-family:'Parisienne', cursive;
    font-size:2rem; color:var(--wine); text-align:right; margin-top:1.6rem;
  }

  .cake-section{ text-align:center; }
  .cake{
    width:190px; margin:0 auto 2.6rem;
    display:flex; flex-direction:column; align-items:center;
  }
  .flame-wrap{ position:relative; height:46px; width:10px; margin-bottom:-2px;}
  .candle{ width:10px; height:44px; background:linear-gradient(180deg,#F7E9D7,#E3C79B); border-radius:2px; position:relative; box-shadow:inset -2px 0 0 rgba(0,0,0,0.06);}
  .flame{
    position:absolute; top:-22px; left:50%; transform:translateX(-50%);
    width:14px; height:22px;
    background:radial-gradient(circle at 50% 70%, #FFF3C4, #F6B93B 55%, #E3672B 90%);
    border-radius:60% 60% 60% 60% / 80% 80% 40% 40%;
    animation:flicker 1.4s ease-in-out infinite;
    transition:opacity .4s ease, transform .4s ease;
  }
  .flame.out{ opacity:0; transform:translateX(-50%) scale(0.2); }
  @keyframes flicker{
    0%,100%{ transform:translateX(-50%) rotate(-2deg) scale(1); }
    50%{ transform:translateX(-50%) rotate(3deg) scale(1.08); }
  }
  .tier{ background:linear-gradient(180deg,#F6DDE3,#E7A7B5); border-radius:6px 6px 2px 2px;}
  .tier.top{ width:110px; height:38px; }
  .tier.bottom{ width:170px; height:52px; margin-top:4px; }
  .plate{ width:200px; height:10px; background:var(--gold); border-radius:50%; margin-top:6px; opacity:0.55;}

  .blow-btn{
    font-family:'Playfair Display', serif; font-style:italic; font-size:1.05rem;
    background:var(--wine); color:var(--cream);
    border:none; padding:0.9rem 2.1rem; border-radius:999px;
    cursor:pointer; letter-spacing:0.02em;
    box-shadow:0 12px 24px -10px rgba(107,39,55,0.5);
    transition:transform .25s ease, box-shadow .25s ease;
  }
  .blow-btn:hover{ transform:translateY(-2px); box-shadow:0 16px 30px -10px rgba(107,39,55,0.6); }
  .blow-btn:disabled{ opacity:0.5; cursor:default; transform:none; }
  .blow-btn:focus-visible, .polaroid:focus-visible { outline:3px solid var(--gold); outline-offset:3px; }

  .wish{
    margin-top:2rem; max-width:480px; margin-inline:auto;
    font-family:'Playfair Display', serif; font-style:italic;
    font-size:1.3rem; color:var(--wine);
    opacity:0; transform:translateY(10px);
    transition:opacity .7s ease, transform .7s ease;
  }
  .wish.show{ opacity:1; transform:translateY(0); }

  footer{
    text-align:center; padding:3.5rem 1.5rem 3rem;
    font-family:'Parisienne', cursive; font-size:1.5rem; color:var(--rose);
  }
  footer span{ display:block; font-family:'Cormorant Garamond', serif; font-size:0.8rem; letter-spacing:0.25em; text-transform:uppercase; color:var(--wine); opacity:0.6; margin-top:0.6rem;}
</style>
</head>
<body>

<div class="petal-field" id="petalField"></div>

<section class="hero">
  <p class="eyebrow">Hoje é o teu dia</p>
  <h1>Luana</h1>
  <p class="tagline">Um cantinho só nosso, para celebrar tudo o que és.</p>
  <div class="divider"></div>
  <span class="scroll-cue">desce para ver ↓</span>
</section>

<section id="album">
  <h2 class="section-title">O nosso álbum, à nossa maneira</h2>
  <div class="gallery">
    <figure class="polaroid" tabindex="0">
      <img class="frame" src="data:image/jpeg;base64,
